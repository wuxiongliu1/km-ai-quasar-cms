# ===========================================
# 存储配置
# ===========================================

# 存储类型: supabase | aliyun-oss
# 默认使用 supabase
VITE_STORAGE_TYPE=supabase

# Supabase Storage Bucket 名称（仅当使用 Supabase 时有效）
VITE_SUPABASE_STORAGE_BUCKET=images

# ===========================================
# 阿里云 OSS 配置
# 复制此文件为 .env 并填写实际配置
# ===========================================

# OSS 区域（例如：oss-cn-hangzhou, oss-cn-shanghai）
VITE_OSS_REGION=oss-cn-hangzhou

# OSS Bucket 名称
VITE_OSS_BUCKET=your-bucket-name

# OSS AccessKey ID
# 注意：生产环境建议使用STS临时凭证，不要在前端暴露永久AccessKey
VITE_OSS_ACCESS_KEY_ID=your-access-key-id

# OSS AccessKey Secret
VITE_OSS_ACCESS_KEY_SECRET=your-access-key-secret

# OSS 自定义域名（可选）
# 如果有绑定自定义域名，填写如：img.yourdomain.com
VITE_OSS_CUSTOM_DOMAIN=

# ===========================================
# Supabase 配置
# ===========================================

# Supabase 项目 URL
# 格式：https://your-project.supabase.co
VITE_SUPABASE_URL=your-supabase-url

# Supabase 匿名密钥 (anon key)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===========================================
# 其他配置
# ===========================================

# API 基础URL
VITE_API_BASE_URL=/api

# 应用标题
VITE_APP_TITLE=清新绿 CMS

# ===========================================
# 微信公众号发布配置
# ===========================================

# 开发环境是否启用微信发布 mock（true/false）
VITE_MOCK_WECHAT_PUBLISH=false

# 微信公众号发布后端 API 地址（默认 /api/wechat/publish）
# 如果你将后端部署在其他地址，可在此配置完整 URL
VITE_WECHAT_PUBLISH_API_URL=/api/wechat/publish
